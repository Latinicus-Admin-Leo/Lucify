# ovisnosti i build
node_modules
dist
dist-ssr
*.local

# gotova namjenska aplikacija: instalacija je stotinjak megabajta i slaže se
# iz izvora s `npm run pakiraj`, pa nema što tražiti u gitu. Ikona (`build/`)
# ostaje, jer se iz nje gradi.
izdanje

# aplikacija za Android: stranica se za nju slaže zasebno, a ključ za potpis
# ne smije nikamo. Tko ga izgubi, novu inačicu ne može instalirati preko stare.
dist-android
android/keystore.properties
*.jks
*.keystore

# logovi
logs
*.log
npm-debug.log*

# okolina
.env
.env.*

# uredivac i OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# yt-dlp uz namjensku aplikaciju: tudi je program, izlazi svaki tjedan i
# dohvaca ga `npm run alati`, pa mu je mjesto uz build, a ne u povijesti.
alati

# glazbena zbirka: snimke su tude autorsko djelo i osobne su, pa ne idu na
# GitHub. Stoje izvan `public/` zato sto Vite sve iz te mape prepisuje u
# `dist/`, pa bi svaki build kopirao 600 MB uzalud.
Glazba/Zvuk

# izvoz za mobitel: ista glazba, samo preimenovana i s upisanim oznakama.
# Zadana mapa stoji uz projekt, pa bi je jedan "git add -A" odnio u povijest.
# Isto vrijedi i za izvoz u jednu datoteku, uz "--zip".
/Lucify za mobitel
/Lucify za mobitel*.zip

# zapis o tome sto je vec otislo na mobitel. Vrijedi za ovu zbirku na ovom
# racunalu, pa nema sto traziti u povijesti Lucifyja.
/.lucify-izvoz.json
